{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": { "deploymentEnabled": { "main": true, "*": false } },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)tests' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/jobs/daily-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/jobs/mail-intake",
      "schedule": "0 7 * * *"
    }
  ]
}
