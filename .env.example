# ── Database (Neon Postgres) ──────────────────────────────────
# De app draait op Postgres (Neon). Op Vercel serverless kan SQLite niet.
# Neon geeft je twee connection strings (dashboard → Connect → "Prisma"):
#   DATABASE_URL = de GEPOOLDE string (host bevat "-pooler") → gebruikt de app.
#   DIRECT_URL   = de DIRECTE string (zonder "-pooler")       → prisma db push/seed.
# BELANGRIJK voor serverless: de GEPOOLDE url moet "&pgbouncer=true" hebben (Prisma
# tegen Neon's PgBouncer, anders krijg je intermitterende 'prepared statement
# already exists'-fouten). "&connection_limit=1" voorkomt dat elke lambda een
# volle pool opent. De DIRECT_URL laat je zónder pgbouncer (nodig voor db push).
# Lokaal wijs je ze bij voorkeur naar een Neon dev-branch (Branches → New branch)
# zodat db:reset je productie-data niet raakt.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Publieke URL (share-links) ────────────────────────────────
# Absolute links in LinkedIn-posts, publieke vacature-/apply-pagina's en de
# talentpool komen hiervandaan. NEXT_PUBLIC_* wordt bij de BUILD ingebakken, dus
# zet 'm in Vercel VÓÓR de build (na de eerste deploy weet je je URL → opnieuw
# deployen, of koppel meteen een custom domein). Leeg = server-side share-teksten
# krijgen een relatief pad (werken op de site zelf, maar niet als je ze elders plakt).
NEXT_PUBLIC_SITE_URL=""

# ── Login-gate (komt later; standaard UIT) ────────────────────
# De app draait zonder verplichte login. Zet je AUTH_REQUIRED="true" in productie,
# zet dan ALTIJD ook een sterke random AUTH_SECRET — anders wordt de sessie-cookie
# met een publiek bekende dev-sleutel getekend en is de gate te omzeilen.
# AUTH_REQUIRED="true"
# AUTH_SECRET=""

# ── Bestandsopslag (Cloudflare R2, S3-compatibel) ─────────────
# Geüploade bestanden (dossiers, CV's, timesheet-inbox, declaraties, ontvangen
# facturen, archief) gaan naar R2. ZONDER deze vars valt de app lokaal terug op
# de map ./uploads (schijf) — handig voor dev. Op Vercel MOET R2 gezet zijn.
# Cloudflare dashboard → R2: maak een bucket, dan "Manage R2 API Tokens" →
# een token met Object Read & Write → kopieer Access Key ID + Secret.
# R2_ACCOUNT_ID = je Cloudflare Account ID (rechtsboven in het R2-overzicht).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="q4s-dashboard"

# ── AI provider ───────────────────────────────────────────────
# Per tier kies je "deepseek" (cloud, OpenAI-compatibel, zeer goedkoop — standaard),
# "anthropic" (cloud, betaald) of "ollama" (gratis, lokaal).
#   AI_PROVIDER      = hoofdmodel: kwaliteitsteksten (vacatures, posts, outreach, matching, assistent)
#   AI_PROVIDER_FAST = hoog-volume werk (relevantiefilter); valt terug op AI_PROVIDER
# Hybride mag, bijv. AI_PROVIDER=deepseek en AI_PROVIDER_FAST=ollama.
AI_PROVIDER=deepseek
AI_PROVIDER_FAST=deepseek

# DeepSeek — nodig zodra een tier op "deepseek" staat. Key: https://platform.deepseek.com
#   deepseek-chat = algemeen (V3);  deepseek-reasoner = redeneren (R1, duurder).
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODEL_FAST=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # of een self-hosted OpenAI-compatibel endpoint

# ── Vision (PDF's/afbeeldingen uitlezen) ──────────────────────
# DeepSeek kan GEEN documenten/afbeeldingen lezen. Voor het uitlezen van
# timesheets, bonnetjes, certificaten en CV's (PDF/scan) gebruik je een
# vision-provider: "gemini" (Google, goedkoop, leest PDF's + afbeeldingen native —
# standaard zodra GEMINI_API_KEY gezet is) of "anthropic". Zonder key vallen die
# features netjes terug (handmatig invullen).
# AI_VISION_PROVIDER=gemini
# Google Gemini — key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Anthropic — nodig zodra een tekst-tier op "anthropic" staat, of als vision-provider
# (AI_VISION_PROVIDER=anthropic) + voor agentische web-sourcing (aiSourceVacancies).
# Key: https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Ollama — gratis & lokaal. Nodig zodra een tier op "ollama" staat.
# Installeer Ollama, draai `ollama serve` en `ollama pull llama3.1`.
# Let op: documenten uitlezen en web-sourcing werken alleen via Anthropic.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_MODEL_FAST=llama3.1

# ── Jobs & webhooks (geheime tokens) ──────────────────────────
# Vercel Cron roept /api/jobs/daily-sync 1×/dag aan (zie vercel.json) en stuurt
# automatisch "Authorization: Bearer <CRON_SECRET>". Zet CRON_SECRET in Vercel
# (willekeurige lange string) om de cron te beveiligen.
CRON_SECRET=""
# Handmatig/extern triggeren kan óók: GET /api/jobs/daily-sync?token=<JOB_SECRET>
JOB_SECRET=""
# Timesheet-inbox e-mail-webhook:  POST /api/inbox/email?token=<INBOX_WEBHOOK_SECRET>
INBOX_WEBHOOK_SECRET=""

# ── Facturen versturen (verzendmap) ───────────────────────────
# Zonder deze SMTP-gegevens draait de verzendmap in "klaarzet-modus": de
# Q4S-mail + PDF-bijlage worden samengesteld (met preview), maar er gaat NIETS
# echt de deur uit. Vul ze in om écht te versturen naar klant + medewerker.
# Voorbeelden: Gmail (smtp.gmail.com:587, app-wachtwoord), Office365
# (smtp.office365.com:587). Gebruik poort 465 of SMTP_SECURE=true voor SSL.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Afzender, bijv. "Q4S <facturen@q4s.nl>". Leeg = SMTP_USER wordt gebruikt.
SMTP_FROM=""
# SMTP_SECURE="true"   # alleen nodig bij poort 465 (impliciete SSL)

# ── OneDrive-koppeling (Microsoft Graph) ──────────────────────
# Eén-richting spiegel: elke upload (CV's, personeelsdossiers, declaraties,
# timesheet-inbox) wordt ook naar de OneDrive van één zakelijk account gezet, in
# de map MS_ROOT_FOLDER. De lokale schijf blijft de bron; deletes in de app
# verwijderen de OneDrive-kopie NIET. Alles is uit zolang deze leeg zijn.
#
# Eenmalige setup (M365-beheerder), zie https://portal.azure.com → Entra ID:
#   1. App-registraties → Nieuwe registratie (single tenant).
#   2. Certificaten & geheimen → Nieuw clientgeheim → waarde = MS_CLIENT_SECRET.
#   3. API-machtigingen → Microsoft Graph → APPLICATIE-machtigingen →
#      Files.ReadWrite.All → "Beheerderstoestemming verlenen".
#   4. Overzicht: Toepassings-id = MS_CLIENT_ID, Adreslijst-id = MS_TENANT_ID.
# MS_DRIVE_USER = UPN/e-mail (of object-id) van het account wiens OneDrive de
# bestanden bevat (app-only kan niet /me gebruiken, wel /users/{deze}).
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_DRIVE_USER=""
MS_ROOT_FOLDER="Q4S Dashboard"
# ONEDRIVE_MIRROR="off"   # spiegel uitzetten zonder de creds te wissen

# --- SnelStart-koppeling (boekhouden) ---
# Optioneel/gated: boek verkoop-, inkoop- en declaratie-bedragen door naar SnelStart.
# Zonder deze sleutels doet de koppeling niets. Vraag een B2B-API-abonnement aan bij
# SnelStart (Ocp-Apim-Subscription-Key) + genereer in jullie administratie een
# koppelsleutel (clientKey). Grootboek-id's zijn administratie-specifiek — bij het
# activeren invullen (of leeg laten).
# SNELSTART_SUBSCRIPTION_KEY=
# SNELSTART_CLIENT_KEY=
# SNELSTART_LEDGER_SALES=
# SNELSTART_LEDGER_PURCHASE=
# SNELSTART_LEDGER_EXPENSE=
